<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_tabby" model="payment.provider">
        <field name="code">tabby</field>
        <field name="state">disabled</field>
        <field name="sequence">350</field>
        <field name="name">Tabby</field>
        <field name="redirect_form_view_id" ref="tabby_redirect_form"/>
        <field name="image_128" type="base64" file="payment_tabby/static/description/icon_checkout.png"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_method_tabby_installments'),])]"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">partial</field>
        <field name="support_refund">partial</field>
    </record>
</odoo>
