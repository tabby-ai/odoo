<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Optional customer mobile on a Tabby line before it is sent: Tabby texts
         the payment link to it, next to the QR code. Empty means QR only. -->
    <t t-name="pos_tabby.PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//t[@t-if=&quot;line.payment_status == 'pending'&quot;]" position="before">
            <div t-if="line.payment_method_id.use_payment_terminal === 'tabby' and ['pending', 'retry'].includes(line.payment_status)"
                 class="tabby_phone px-2 pt-2 w-100">
                <input type="tel" inputmode="tel" autocomplete="off" class="form-control form-control-sm"
                       placeholder="Mobile for SMS link (optional)"
                       t-att-value="line.tabby_phone or ''"
                       t-on-input="(ev) => line.tabby_phone = ev.target.value"
                       t-on-click.stop=""/>
            </div>
        </xpath>
    </t>
</templates>
